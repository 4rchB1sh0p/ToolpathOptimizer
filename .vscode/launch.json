{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CLI: analyze plate sample",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/ToolpathOptimizer.Cli/bin/Debug/net10.0/ToolpathOptimizer.Cli.dll",
            "args": [
                "analyze",
                "--points", "${workspaceFolder}/samples/plate.csv",
                "--job", "${workspaceFolder}/samples/plate-job.json",
                "--output", "${workspaceFolder}/samples/plate.report.json",
                "--overwrite"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "justMyCode": true
        },
        {
            "name": "Web: Development (http://localhost:5080)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/ToolpathOptimizer.Web/bin/Debug/net10.0/ToolpathOptimizer.Web.dll",
            "cwd": "${workspaceFolder}/src/ToolpathOptimizer.Web",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5080"
            },
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "justMyCode": true
        }
    ]
}
